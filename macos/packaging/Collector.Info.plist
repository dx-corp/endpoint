<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The collector is a launch daemon, wrapped in an app-like bundle so a
     Developer ID provisioning profile can back its restricted Endpoint
     Security entitlement (Contents/embedded.provisionprofile). -->
<plist version="1.0"><dict>
<key>CFBundleIdentifier</key><string>com.evalops.merlin.collector</string>
<key>CFBundleName</key><string>Deixic Endpoint Collector</string>
<key>CFBundleExecutable</key><string>merlin-macos</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleVersion</key><string>0.1.0</string>
<key>CFBundleShortVersionString</key><string>0.1.0</string>
<key>LSMinimumSystemVersion</key><string>13.0</string>
<key>LSBackgroundOnly</key><true/>
</dict></plist>
