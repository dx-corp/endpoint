MERLIN_SYNC_URL=https://merlin-sync.example.com
MERLIN_DEVICE_ID=dev_0123456789abcdef01234567
MERLIN_DEVICE_TOKEN=replace-with-64-hex-character-device-token
MERLIN_POLICY_PUBLIC_KEYS=replace-with-comma-separated-ed25519-public-keys
# Optional JSON array of at most eight admin-chosen workspace roots. Escape it
# as a single value in this root-owned systemd EnvironmentFile.
# MERLIN_AGENT_WORKSPACE_ROOTS='["/srv/projects"]'
